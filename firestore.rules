rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidStringList(arr, maxItems, maxItemLen) {
      return arr is list
        && arr.size() <= maxItems
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= maxItemLen));
    }

    function isValidPatrolLog(data) {
      return data.keys().hasAll([
          'ownerId', 'ownerName', 'locationName', 'zoneCategory', 'patrolStatus',
          'followUpResolved', 'summary', 'observations', 'transcript', 'actionItems',
          'teacherOrUnit', 'photoDataUrl', 'monthKey', 'patrolDateStr', 'patrolTimeStr',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'ownerName', 'locationName', 'zoneCategory', 'patrolStatus',
          'followUpResolved', 'summary', 'observations', 'transcript', 'actionItems',
          'teacherOrUnit', 'photoDataUrl', 'monthKey', 'patrolDateStr', 'patrolTimeStr',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 100
        && data.locationName is string && data.locationName.size() >= 1 && data.locationName.size() <= 120
        && data.zoneCategory in ['教室教學', '校園環境', '安全設施', '學生秩序', '其他場域']
        && data.patrolStatus in ['正常良好', '需追蹤提醒', '異常待修']
        && data.followUpResolved is bool
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 600
        && data.observations is string && data.observations.size() <= 2000
        && data.transcript is string && data.transcript.size() <= 3000
        && isValidStringList(data.actionItems, 10, 200)
        && data.teacherOrUnit is string && data.teacherOrUnit.size() <= 100
        && data.photoDataUrl is string && data.photoDataUrl.size() <= 350000
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.patrolDateStr is string && data.patrolDateStr.size() == 10 && data.patrolDateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.patrolTimeStr is string && data.patrolTimeStr.size() == 5 && data.patrolTimeStr.matches('^[0-9]{2}:[0-9]{2}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMonthlyReport(data) {
      return data.keys().hasAll([
          'ownerId', 'monthKey', 'totalCount', 'normalCount', 'followUpCount',
          'issueCount', 'executiveSummary', 'keyHighlights', 'recommendations',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'monthKey', 'totalCount', 'normalCount', 'followUpCount',
          'issueCount', 'executiveSummary', 'keyHighlights', 'recommendations',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.totalCount is int && data.totalCount >= 0 && data.totalCount <= 10000
        && data.normalCount is int && data.normalCount >= 0 && data.normalCount <= 10000
        && data.followUpCount is int && data.followUpCount >= 0 && data.followUpCount <= 10000
        && data.issueCount is int && data.issueCount >= 0 && data.issueCount <= 10000
        && data.executiveSummary is string && data.executiveSummary.size() >= 1 && data.executiveSummary.size() <= 4000
        && isValidStringList(data.keyHighlights, 10, 400)
        && isValidStringList(data.recommendations, 10, 400)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /patrolLogs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && existing().ownerId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(logId)
        && isValidPatrolLog(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(logId)
        && existing().ownerId == request.auth.uid
        && isValidPatrolLog(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'locationName', 'zoneCategory', 'patrolStatus', 'followUpResolved',
            'summary', 'observations', 'transcript', 'actionItems',
            'teacherOrUnit', 'photoDataUrl', 'monthKey', 'patrolDateStr', 'patrolTimeStr', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'followUpResolved', 'patrolStatus', 'updatedAt'
          ])
        );
      allow delete: if isVerifiedUser() && isValidId(logId) && existing().ownerId == request.auth.uid;
    }

    match /monthlyReports/{reportId} {
      allow get: if isVerifiedUser() && isValidId(reportId) && existing().ownerId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(reportId)
        && isValidMonthlyReport(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(reportId)
        && existing().ownerId == request.auth.uid
        && isValidMonthlyReport(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().monthKey == existing().monthKey
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'totalCount', 'normalCount', 'followUpCount', 'issueCount',
          'executiveSummary', 'keyHighlights', 'recommendations', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(reportId) && existing().ownerId == request.auth.uid;
    }
  }
}
